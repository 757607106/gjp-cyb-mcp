# ============================================================
# 本地/测试环境配置（GJP_ENV 缺省或 local 时加载）
# 生产环境使用 GJP_ENV=production，加载 config/production.env
# 系统环境变量优先于本文件；未列出的变量使用代码内置默认值
# ============================================================

# 部署级固定 ERP API 地址，启动开单 MCP 服务必填；
# 不从租户会话、MCP Header 或 Tool 参数读取
ERP_BILLING_BASE_URL=https://test-ai.yuncyb.com/aicyberp-api

# ERP API 请求超时（秒），默认 30
ERP_BILLING_TIMEOUT_SECONDS=30

# ============================================================
# 商品匹配配置（erp_billing.config）
# ============================================================

# 模糊匹配推荐阈值（0~1），低于该分数的商品只进推荐不直接确认，默认 0.60
ERP_BILLING_RECOMMENDATION_SCORE=0.60

# ============================================================
# 日志配置（gjp_common.logging_config，服务启动时生效）
# ============================================================

# 业务日志总开关：false 完全静默，默认 true
GJP_LOG_ENABLED=true

# 日志级别：DEBUG 输出 ERP 请求明细；INFO 仅高层流程，默认 INFO
GJP_LOG_LEVEL=INFO
