# ============================================================
# 生产环境配置（GJP_ENV=production 时加载）
# 本文件只放非敏感默认值；敏感与部署相关的值（如 ERP API 地址）
# 必须由部署平台通过系统环境变量注入，系统环境变量优先于本文件
# ============================================================

# 部署级固定 ERP API 地址，启动开单 MCP 服务必填；
# 系统环境变量 ERP_BILLING_BASE_URL 优先于此值
ERP_BILLING_BASE_URL=https://new.yuncyb.com/aicyberp-api

# 生产 JWT HS256 验签密钥（Bearer 方式必填）；
# 只能由部署平台通过环境变量 ERP_BILLING_JWT_SECRET 注入。
# 纯 API Key 部署（不使用 Bearer）可省略本项
# ERP_BILLING_JWT_SECRET=

# ERP API 请求超时（秒），默认 30
ERP_BILLING_TIMEOUT_SECONDS=30

# ============================================================
# 商品匹配配置（erp_billing.config）
# ============================================================

# 模糊匹配推荐阈值（0~1），低于该分数的商品只进推荐不直接确认，默认 0.60
ERP_BILLING_RECOMMENDATION_SCORE=0.60

# ============================================================
# 日志配置（gjp_common.logging_config，服务启动时生效）
# ============================================================

# 生产默认关闭凭据明细输出；业务日志保持 INFO 级别
GJP_LOG_ENABLED=true
GJP_LOG_LEVEL=INFO
